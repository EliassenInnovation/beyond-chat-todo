# Choose one provider. The profile supplies model defaults for every role
# (agent, judge, persona and guard). See docs/guides/models.md for the tested configurations and results.
EVALBASICS_PROVIDER=openai

# Fill in only the key for your chosen provider. Never commit your .env file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides; leave commented to use the selected profile.
# EVALBASICS_MODEL=your-tool-capable-model-id
# EVALBASICS_JUDGE_MODEL=your-structured-output-model-id
# EVALBASICS_PERSONA_MODEL=your-structured-output-model-id
# EVALBASICS_ACTION_GUARD_MODEL=your-structured-output-model-id
# For mixed providers or gateways, see docs/guides/models.md.
# OPENAI_BASE_URL=http://localhost:8000/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Show the visible persona player without enabling trace export.
EVALBASICS_PERSONA_PLAYER=true

# Guards check proposed actions against the user's intent before execution.
EVALBASICS_GUARDS=todos.merge_unnamed,todos.target_identified,todos.extra_tasks,todos.omitted_tasks,todos.operation_matches,todos.wrong_values

# Optional tracing; keys must belong to your own Langfuse project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENABLED=false
