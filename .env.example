# Optional for the list; required for chat and paid evaluations.
OPENAI_API_KEY=
# Tested model selection; see docs/guides/models.md for provider requirements.
# Agent: OpenAI-compatible tool calling. Judge/persona: structured output.
EVALBASICS_MODEL=gpt-6-luna
EVALBASICS_JUDGE_MODEL=gpt-6-luna
EVALBASICS_PERSONA_MODEL=gpt-4.1-mini
# Shared by all OpenAI-compatible calls; omit for the default OpenAI endpoint.
# OPENAI_BASE_URL=http://localhost:8000/v1
# Native Anthropic is implemented for judges only (claude- model IDs).
# ANTHROPIC_API_KEY=

# Show the visible persona player without enabling trace export.
EVALBASICS_PERSONA_PLAYER=true

# Optional tracing. Credentials must belong to your own Langfuse project.
# Nothing is loaded from another repository.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENABLED=false

# Guards run before completion, date changes, deletion requests, and unnamed merges.
# Merge guard requires the OpenAI Decisions API; the other guards use strict JSON-schema chat.
# Override this list to select guards; an empty shell environment value disables all guards.
EVALBASICS_GUARDS=todos.merge_unnamed,todos.target_identified,todos.extra_tasks,todos.omitted_tasks,todos.operation_matches,todos.wrong_values

# Uses the existing OpenAI-compatible connection.
EVALBASICS_ACTION_GUARD_MODEL=gpt-6-luna
